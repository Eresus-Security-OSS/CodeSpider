# =============================================================================
# CodeSpider - 24/7 Agentic Gitea PR Reviewer Configuration
# =============================================================================

# HTTP server listen address
CODESPIDER_LISTEN_ADDR=:8080

# Gitea instance configuration
GITEA_BASE_URL=https://gitea.example.com
GITEA_TOKEN=replace-with-gitea-bot-token
GITEA_WEBHOOK_SECRET=replace-with-webhook-hmac-secret
GITEA_BOT_USERNAME=codespider
SKIP_DRAFT_PRS=true
IGNORE_BOT_PRS=true

# OpenAI-compatible LLM endpoint (vLLM, LiteLLM, OpenAI, OpenRouter, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-5
LLM_TIMEOUT_SECONDS=120

# Agentic execution guardrails
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS_PER_RUN=32000
AGENT_SKILLS_DIR=./skills
AGENT_DEFAULT_SKILLS=security,code-quality
AGENT_ENABLE_WRITE=false

# 24/7 Daemon & Workspace settings
DATA_DIR=./data
WORKERS=2
RECONCILE_INTERVAL_SECONDS=300
LOG_LEVEL=info
